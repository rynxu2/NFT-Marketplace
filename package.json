    "@solana/web3.js": "^1.98.4",
    "@supabase/supabase-js": "^2.105.3",
    "@tanstack/react-query": "^5.100.10",
    "@wagmi/core": "^3.4.10",
    "bs58": "^6.0.0",
    "cloudinary": "^2.10.0",
